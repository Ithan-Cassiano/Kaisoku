<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/list_selector"
	tools:layout_height="@dimen/recommendation_item_height">

	<com.kosen.reader.image.ui.CoverImageView
		android:id="@+id/imageView_cover"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:scaleType="centerCrop"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kosen.Cover"
		tools:src="@tools:sample/backgrounds/scenic" />

	<View
		android:id="@+id/gradient_overlay"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:background="@drawable/bg_scrim_bottom"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintHeight_percent="0.55"
		app:layout_constraintStart_toStartOf="parent" />

	<com.kosen.reader.core.ui.image.FaviconView
		android:id="@+id/imageView_source"
		android:layout_width="24dp"
		android:layout_height="24dp"
		android:layout_margin="12dp"
		android:background="@drawable/bg_list_icons"
		android:padding="2dp"
		android:visibility="gone"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintTop_toTopOf="parent"
		app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kosen.Cover"
		tools:src="@tools:sample/avatars"
		tools:visibility="visible" />

	<TextView
		android:id="@+id/textView_title"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="4dp"
		android:ellipsize="end"
		android:maxLines="2"
		android:textAppearance="?attr/textAppearanceTitleMedium"
		android:textColor="@android:color/white"
		app:layout_constraintBottom_toTopOf="@+id/progressBar"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		tools:text="Nesta Vida, Você Será o Cão de Caça" />

	<com.google.android.material.progressindicator.LinearProgressIndicator
		android:id="@+id/progressBar"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="4dp"
		android:visibility="gone"
		app:indicatorColor="@android:color/white"
		app:layout_constraintBottom_toTopOf="@+id/textView_subtitle"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:trackColor="#66FFFFFF"
		tools:progress="40"
		tools:visibility="visible" />

	<com.kosen.reader.core.ui.widgets.MultilineEllipsizeTextView
		android:id="@+id/textView_subtitle"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="16dp"
		android:layout_marginBottom="12dp"
		android:ellipsize="end"
		android:maxLines="2"
		android:textAppearance="?attr/textAppearanceBodySmall"
		android:textColor="#E6FFFFFF"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		tools:text="Drama, Romance • Shoujo" />

</androidx.constraintlayout.widget.ConstraintLayout>
