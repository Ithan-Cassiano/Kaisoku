<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="@dimen/list_spacing_normal"
		android:paddingTop="@dimen/list_spacing_normal"
		android:paddingBottom="@dimen/margin_small">

		<ImageButton
			android:id="@+id/button_back_private_history"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/private_history_back_to_main"
			android:padding="8dp"
			android:src="@drawable/ic_prev"
			android:visibility="gone"
			app:tint="?attr/colorOnSurface"
			tools:visibility="visible" />

		<TextView
			android:id="@+id/textView_page_title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="4dp"
			android:layout_weight="1"
			android:text="@string/history_home_title"
			android:textAppearance="?attr/textAppearanceHeadlineMedium" />

	</LinearLayout>

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/banner_private_history"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="@dimen/list_spacing_normal"
		android:layout_marginBottom="@dimen/margin_small"
		android:visibility="gone"
		app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
		app:cardElevation="0dp"
		tools:visibility="visible">

		<TextView
			android:id="@+id/textView_private_banner"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="@dimen/margin_normal"
			android:text="@string/private_history_banner_message"
			android:textAppearance="?attr/textAppearanceBodyMedium" />

	</com.google.android.material.card.MaterialCardView>

	<TextView
		android:id="@+id/textView_stats_hint"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingHorizontal="@dimen/list_spacing_normal"
		android:paddingBottom="@dimen/margin_small"
		android:textAppearance="?attr/textAppearanceBodySmall"
		android:textColor="?attr/colorPrimary"
		android:visibility="gone"
		tools:text="12 h esta semana · Ver estatísticas"
		tools:visibility="visible" />

	<include
		android:id="@+id/list_container"
		layout="@layout/fragment_list"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1" />

</LinearLayout>
