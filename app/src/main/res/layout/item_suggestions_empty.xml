<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:gravity="center_horizontal"
	android:orientation="vertical"
	android:paddingHorizontal="@dimen/list_spacing_normal"
	android:paddingVertical="@dimen/margin_normal">

	<ImageView
		android:id="@+id/icon"
		android:layout_width="96dp"
		android:layout_height="96dp"
		android:importantForAccessibility="no"
		android:src="@drawable/ic_suggestion"
		app:tint="?attr/colorPrimary" />

	<TextView
		android:id="@+id/text_primary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_normal"
		android:gravity="center"
		android:text="@string/suggestions_empty_title"
		android:textAppearance="?attr/textAppearanceTitleMedium" />

	<TextView
		android:id="@+id/text_secondary"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_small"
		android:gravity="center"
		android:textAppearance="?attr/textAppearanceBodyMedium"
		android:textColor="?android:attr/textColorSecondary"
		tools:text="Nenhuma sugestão com Sem Manhua — tente remover filtros." />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_refresh"
		style="@style/Widget.Material3.Button"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_normal"
		android:text="@string/refresh_suggestions"
		app:icon="@drawable/ic_updated" />

	<com.google.android.material.button.MaterialButton
		android:id="@+id/button_sources"
		style="@style/Widget.Material3.Button.TextButton"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/explore_sources" />

</LinearLayout>
