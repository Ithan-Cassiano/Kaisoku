<?xml version="1.0" encoding="utf-8"?>
<!-- Kosen UX — polished empty state. Same ids as the base layout. -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="center"
	android:orientation="vertical"
	android:paddingHorizontal="40dp"
	android:paddingBottom="?actionBarSize">

	<com.kosen.reader.core.image.CoilImageView
		android:id="@+id/icon"
		android:layout_width="168dp"
		android:layout_height="168dp"
		android:alpha="0.9"
		android:contentDescription="@null"
		android:scaleType="fitCenter"
		app:crossfadeEnabled="false"
		tools:src="@drawable/ic_empty_favourites" />

	<TextView
		android:id="@+id/textPrimary"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_normal"
		android:gravity="center"
		android:textAppearance="?attr/textAppearanceHeadlineSmall"
		tools:text="@tools:sample/lorem[3]" />

	<TextView
		android:id="@+id/textSecondary"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_small"
		android:gravity="center"
		android:lineSpacingMultiplier="1.15"
		android:textAppearance="?attr/textAppearanceBodyLarge"
		android:textColor="?attr/colorOnSurfaceVariant"
		tools:text="@tools:sample/lorem[15]" />

	<Button
		android:id="@+id/button_retry"
		style="?materialButtonTonalStyle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_normal"
		android:visibility="gone"
		tools:text="@string/try_again"
		tools:visibility="visible" />

	<Button
		android:id="@+id/button_secondary"
		style="?materialButtonOutlinedStyle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/margin_small"
		android:visibility="gone" />

	<Button
		android:id="@+id/button_tertiary"
		style="?borderlessButtonStyle"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:visibility="gone" />

</LinearLayout>
