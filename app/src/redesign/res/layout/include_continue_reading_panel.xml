<?xml version="1.0" encoding="utf-8"?>
<!-- Kosen UX — hero continue card + FOR YOU carousel (mockup). -->
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical">

	<LinearLayout
		android:id="@+id/continue_header"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="@dimen/list_spacing_normal"
		android:layout_marginBottom="@dimen/margin_small"
		android:orientation="vertical"
		android:visibility="gone"
		tools:visibility="visible">

		<LinearLayout
			android:id="@+id/continue_hero_card"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_ux_card"
			android:orientation="vertical"
			android:padding="@dimen/margin_normal"
			android:visibility="gone"
			tools:visibility="visible">

			<TextView
				style="@style/TextAppearance.KosenUx.Section"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="@dimen/margin_small"
				android:text="@string/continue_reading" />

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

				<com.kosen.reader.image.ui.CoverImageView
					android:id="@+id/continue_hero_cover"
					android:layout_width="88dp"
					android:layout_height="124dp"
					android:scaleType="centerCrop"
					app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Kosen.Cover"
					tools:src="@tools:sample/backgrounds/scenic" />

				<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_marginStart="@dimen/margin_normal"
					android:layout_weight="1"
					android:orientation="vertical">

					<TextView
						android:id="@+id/continue_hero_title"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:ellipsize="end"
						android:maxLines="2"
						android:textAppearance="?attr/textAppearanceTitleMedium"
						android:textColor="@color/kosenux_onSurface"
						tools:text="Solo Leveling, Vol. 5" />

					<TextView
						android:id="@+id/continue_hero_subtitle"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="4dp"
						android:ellipsize="end"
						android:maxLines="2"
						android:textAppearance="?attr/textAppearanceBodySmall"
						android:textColor="@color/kosenux_onSurfaceVariant"
						tools:text="Cap. 42 • Chugong" />

					<ProgressBar
						android:id="@+id/continue_hero_progress"
						style="@android:style/Widget.ProgressBar.Horizontal"
						android:layout_width="match_parent"
						android:layout_height="4dp"
						android:layout_marginTop="12dp"
						android:max="100"
						android:progressDrawable="@drawable/bg_ux_progress"
						tools:progress="78" />

					<TextView
						android:id="@+id/continue_hero_progress_label"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="6dp"
						android:textAppearance="?attr/textAppearanceLabelMedium"
						android:textColor="@color/kosenux_onSurfaceVariant"
						tools:text="78% • 3 caps restantes" />

				</LinearLayout>

			</LinearLayout>

			<Button
				android:id="@+id/button_continue_hero"
				style="@style/Widget.KosenUx.Button.Primary"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/margin_normal"
				android:text="@string/ux_continue_reading_cta" />

		</LinearLayout>

		<TextView
			android:id="@+id/section_for_you"
			style="@style/TextAppearance.KosenUx.Section"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="@dimen/margin_small"
			android:paddingBottom="@dimen/margin_small"
			android:text="@string/ux_section_for_you"
			android:visibility="gone"
			tools:visibility="visible" />

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/continue_carousel"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:clipToPadding="false"
			android:nestedScrollingEnabled="false"
			android:visibility="gone"
			tools:itemCount="3"
			tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
			tools:listitem="@layout/item_continue_reading"
			tools:orientation="horizontal"
			tools:visibility="visible" />

	</LinearLayout>

	<com.google.android.material.chip.Chip
		android:id="@+id/chip_continue_collapsed"
		style="@style/Widget.Kosen.Chip.Assist"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginHorizontal="@dimen/list_spacing_normal"
		android:layout_marginBottom="@dimen/margin_small"
		android:text="@string/continue_reading"
		android:visibility="gone"
		app:chipIcon="@drawable/ic_history"
		tools:visibility="visible" />

</LinearLayout>
